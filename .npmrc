# Pin legacy-peer-deps OFF for this project. A global ~/.npmrc with
# legacy-peer-deps=true omits peer packages (e.g. @react-native/babel-preset
# and its metro/hermes subtree) from the lockfile, which then fails EAS Build's
# strict `npm ci` (the cloud builder resolves those peers and finds the lock
# out of sync). Committing this keeps local installs and EAS in agreement.
legacy-peer-deps=false
